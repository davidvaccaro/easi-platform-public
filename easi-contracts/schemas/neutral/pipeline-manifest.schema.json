{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/pipeline-manifest.schema.json",
  "title": "EASI Neutral Pipeline Manifest Schema",
  "description": "Language-neutral pipeline composition contract for EASI pipeline definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "composition"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "EASI.PipelineManifest"
    },
    "version": {
      "$ref": "./common.schema.json#/$defs/semanticVersion"
    },
    "metadata": {
      "$ref": "#/$defs/manifestMetadata"
    },
    "composition": {
      "$ref": "#/$defs/pipelineComposition"
    },
    "executionHints": {
      "$ref": "#/$defs/executionHints"
    },
    "extensions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    }
  },
  "$defs": {
    "manifestMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "pipelineComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "parser",
        "terminal"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/sourceStage"
        },
        "parser": {
          "$ref": "./common.schema.json#/$defs/stageDescriptor"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/stageDescriptor"
          }
        },
        "terminal": {
          "$ref": "./common.schema.json#/$defs/stageDescriptor"
        },
        "destination": {
          "oneOf": [
            {
              "$ref": "#/$defs/destinationStage"
            },
            {
              "type": "null"
            }
          ]
        },
        "routing": {
          "$ref": "#/$defs/routingDescriptor"
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "sourceStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader"
      ],
      "properties": {
        "reader": {
          "$ref": "./common.schema.json#/$defs/stageDescriptor"
        },
        "binding": {
          "$ref": "./common.schema.json#/$defs/bindingDescriptor"
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "destinationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer"
      ],
      "properties": {
        "writer": {
          "$ref": "./common.schema.json#/$defs/stageDescriptor"
        },
        "binding": {
          "$ref": "./common.schema.json#/$defs/bindingDescriptor"
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "routingDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "branches"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "conditional",
            "split"
          ]
        },
        "discriminator": {
          "type": [
            "string",
            "null"
          ]
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeBranch"
          }
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "routeBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "when"
      ],
      "properties": {
        "name": {
          "$ref": "./common.schema.json#/$defs/nonEmptyString"
        },
        "when": {
          "$ref": "./common.schema.json#/$defs/nonEmptyString"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/stageDescriptor"
          }
        },
        "terminal": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/stageDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "oneOf": [
            {
              "$ref": "#/$defs/destinationStage"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "executionHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultMode": {
          "type": "string",
          "enum": [
            "process",
            "start"
          ]
        },
        "collectOutput": {
          "type": "boolean"
        },
        "traceDefault": {
          "type": "boolean"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    }
  }
}
