{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/pipeline-execution-result.schema.json",
  "title": "EASI Neutral Pipeline Execution Result Schema",
  "description": "Language-neutral execution result contract for process/start pipeline runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "mode",
    "status",
    "startedAt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "EASI.PipelineExecutionResult"
    },
    "version": {
      "$ref": "./common.schema.json#/$defs/semanticVersion"
    },
    "mode": {
      "type": "string",
      "enum": [
        "process",
        "start"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "stopped",
        "cancelled",
        "running"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "iterations": {
      "type": "integer",
      "minimum": 0
    },
    "resultCollection": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/pipelineResultCollectionEnvelope"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationResults": {
      "type": "array",
      "items": {
        "$ref": "./pipeline-operation-result.schema.json"
      }
    },
    "trace": {
      "oneOf": [
        {
          "$ref": "./stream-trace.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/diagnostic"
      }
    },
    "error": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/diagnostic"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "$ref": "#/$defs/executionMetrics"
    },
    "extensions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    }
  },
  "$defs": {
    "executionMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytesRead": {
          "type": "integer",
          "minimum": 0
        },
        "bytesWritten": {
          "type": "integer",
          "minimum": 0
        },
        "resultCount": {
          "type": "integer",
          "minimum": 0
        },
        "errorCount": {
          "type": "integer",
          "minimum": 0
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    }
  }
}
