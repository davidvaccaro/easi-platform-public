{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/testgen-request.schema.json",
  "title": "EASI Neutral Test Generation Request Schema",
  "description": "Language-neutral request contract for generating tests from a pipeline manifest and optional baseline expectations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "targetLanguage",
    "manifest"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "EASI.TestgenRequest"
    },
    "version": {
      "$ref": "./common.schema.json#/$defs/semanticVersion"
    },
    "targetLanguage": {
      "type": "string",
      "enum": [
        "javascript",
        "csharp",
        "java",
        "python"
      ]
    },
    "manifest": {
      "$ref": "#/$defs/manifestSelector"
    },
    "testType": {
      "type": "string",
      "enum": [
        "unit",
        "integration",
        "regression"
      ]
    },
    "framework": {
      "type": [
        "string",
        "null"
      ]
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testFixture"
      }
    },
    "baseline": {
      "$ref": "#/$defs/baselineAssertions"
    },
    "includeNegativeCases": {
      "type": "boolean"
    },
    "sourceExecutionResultRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    }
  },
  "$defs": {
    "manifestSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "inline": {
          "$ref": "./pipeline-manifest.schema.json"
        }
      },
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "inline"
          ]
        }
      ]
    },
    "testFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "./common.schema.json#/$defs/endpointReference"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "baselineAssertions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedStatus": {
          "type": "string",
          "enum": [
            "success",
            "failed",
            "stopped",
            "cancelled"
          ]
        },
        "expectedMinResults": {
          "type": "integer",
          "minimum": 0
        },
        "expectedMaxResults": {
          "type": "integer",
          "minimum": 0
        },
        "assertNoDiagnostics": {
          "type": "boolean"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/jsonObject"
          }
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    }
  }
}
