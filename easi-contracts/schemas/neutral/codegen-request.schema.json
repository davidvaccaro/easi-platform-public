{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/codegen-request.schema.json",
  "title": "EASI Neutral Code Generation Request Schema",
  "description": "Language-neutral request contract for generating implementation code from a pipeline manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "targetLanguage",
    "manifest"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "EASI.CodegenRequest"
    },
    "version": {
      "$ref": "./common.schema.json#/$defs/semanticVersion"
    },
    "targetLanguage": {
      "type": "string",
      "enum": [
        "javascript",
        "csharp",
        "java",
        "python"
      ]
    },
    "manifest": {
      "$ref": "#/$defs/manifestSelector"
    },
    "style": {
      "$ref": "#/$defs/codeStyle"
    },
    "output": {
      "$ref": "#/$defs/outputDescriptor"
    },
    "extensions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    }
  },
  "$defs": {
    "manifestSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "inline": {
          "$ref": "./pipeline-manifest.schema.json"
        }
      },
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "inline"
          ]
        }
      ]
    },
    "codeStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiStyle": {
          "type": "string",
          "enum": [
            "fluent-builder",
            "imperative",
            "manifest-literal"
          ]
        },
        "bindingStyle": {
          "type": "string",
          "enum": [
            "early",
            "late",
            "hybrid",
            "mixed"
          ]
        },
        "includeComments": {
          "type": "boolean"
        },
        "includeImports": {
          "type": "boolean"
        },
        "includeResultHandling": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "outputDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "snippet",
            "single-file",
            "project-scaffold"
          ]
        },
        "className": {
          "type": [
            "string",
            "null"
          ]
        },
        "functionName": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "packageName": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    }
  }
}
