{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/common.schema.json",
  "title": "EASI Neutral Common Schema",
  "description": "Shared neutral schema definitions reused by EASI neutral contracts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?(?:[-+].*)?$"
    },
    "jsonObject": {
      "type": "object"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpointReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file-path",
            "folder-path",
            "http-url",
            "https-url",
            "dicomweb-url",
            "dimse-association",
            "byte-buffer-ref",
            "part-buffer-ref",
            "writable-stream-ref",
            "local-connector-ref",
            "remote-connector-ref",
            "custom"
          ]
        },
        "value": {
          "$ref": "#/$defs/jsonValue"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "stageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "$ref": "#/$defs/jsonObject"
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "bindingDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "early",
            "late",
            "hybrid",
            "implicit"
          ]
        },
        "endpoint": {
          "oneOf": [
            {
              "$ref": "#/$defs/endpointReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "$ref": "#/$defs/jsonObject"
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "details": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "payloadEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "data"
      ],
      "properties": {
        "encoding": {
          "type": "string",
          "enum": [
            "base64",
            "hex",
            "uri"
          ]
        },
        "data": {
          "type": "string"
        },
        "mediaType": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "pipelineResultCollectionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultType",
        "count",
        "isEmpty",
        "items"
      ],
      "properties": {
        "resultType": {
          "type": "string",
          "const": "PipelineResultCollection"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "isEmpty": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "operationCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stability": {
          "type": "string",
          "enum": [
            "stable",
            "experimental",
            "deprecated"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    }
  }
}
