{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/stream-trace.schema.json",
  "title": "EASI Neutral Stream Trace Schema",
  "description": "Language-neutral stream lifecycle trace envelope for parser/handler event flow inspection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "events"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "EASI.StreamTrace"
    },
    "version": {
      "$ref": "./common.schema.json#/$defs/semanticVersion"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traceEvent"
      }
    },
    "extensions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    }
  },
  "$defs": {
    "traceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "actor",
        "event",
        "status"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "offsetMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actor": {
          "type": "string",
          "enum": [
            "pipeline",
            "reader",
            "parser",
            "adapter",
            "filter",
            "terminal",
            "writer",
            "transport",
            "custom"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "start",
            "progress",
            "end",
            "error"
          ]
        },
        "event": {
          "$ref": "./common.schema.json#/$defs/nonEmptyString"
        },
        "status": {
          "type": "string",
          "enum": [
            "CONTINUE",
            "SUCCESS",
            "STOP",
            "JUMP",
            "FAIL",
            "INFO",
            "NONE"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/diagnostic"
          }
        }
      }
    }
  }
}
