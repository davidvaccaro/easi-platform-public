{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/pipeline-execution-request.schema.json",
  "title": "EASI Neutral Pipeline Execution Request Schema",
  "description": "Language-neutral run request contract for process/start pipeline execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "mode",
    "manifest"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "EASI.PipelineExecutionRequest"
    },
    "version": {
      "$ref": "./common.schema.json#/$defs/semanticVersion"
    },
    "mode": {
      "type": "string",
      "enum": [
        "process",
        "start"
      ]
    },
    "manifest": {
      "$ref": "#/$defs/manifestSelector"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/endpointReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/endpointReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceOptions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    },
    "destinationOptions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    },
    "options": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycleOptions"
    },
    "runtimeTarget": {
      "type": "string",
      "enum": [
        "auto",
        "hosted",
        "local-bridge"
      ]
    },
    "trace": {
      "type": "boolean"
    },
    "traceDetail": {
      "type": "string",
      "enum": [
        "basic",
        "full"
      ]
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "extensions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    }
  },
  "$defs": {
    "manifestSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "inline": {
          "$ref": "./pipeline-manifest.schema.json"
        }
      },
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "inline"
          ]
        }
      ]
    },
    "lifecycleOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "continueOnError": {
          "type": "boolean"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    }
  }
}
