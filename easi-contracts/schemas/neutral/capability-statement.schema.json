{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/neutral/capability-statement.schema.json",
  "title": "EASI Neutral Capability Statement Schema",
  "description": "Language-neutral statement of runtime capabilities for EASI implementations and services.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "implementation",
    "features"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "EASI.CapabilityStatement"
    },
    "version": {
      "$ref": "./common.schema.json#/$defs/semanticVersion"
    },
    "implementation": {
      "$ref": "#/$defs/implementationDescriptor"
    },
    "supportedSources": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/operationCapability"
      }
    },
    "supportedParsers": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/operationCapability"
      }
    },
    "supportedTransforms": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/operationCapability"
      }
    },
    "supportedTerminals": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/operationCapability"
      }
    },
    "supportedDestinations": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/operationCapability"
      }
    },
    "features": {
      "$ref": "#/$defs/featureFlags"
    },
    "limits": {
      "$ref": "#/$defs/runtimeLimits"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "extensions": {
      "$ref": "./common.schema.json#/$defs/jsonObject"
    }
  },
  "$defs": {
    "implementationDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "runtime",
        "languages"
      ],
      "properties": {
        "name": {
          "$ref": "./common.schema.json#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "./common.schema.json#/$defs/semanticVersion"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "node",
            "browser",
            "dotnet",
            "jvm",
            "python",
            "mixed"
          ]
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "javascript",
              "csharp",
              "java",
              "python"
            ]
          }
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process",
        "start",
        "routing",
        "dicom",
        "dicomweb",
        "dimse",
        "codegen",
        "testgen"
      ],
      "properties": {
        "process": {
          "type": "boolean"
        },
        "start": {
          "type": "boolean"
        },
        "routing": {
          "type": "boolean"
        },
        "mixedImaging": {
          "type": "boolean"
        },
        "dicom": {
          "type": "boolean"
        },
        "dicomweb": {
          "type": "boolean"
        },
        "dimse": {
          "type": "boolean"
        },
        "json": {
          "type": "boolean"
        },
        "xml": {
          "type": "boolean"
        },
        "codegen": {
          "type": "boolean"
        },
        "testgen": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    },
    "runtimeLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPipelineDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maxBranchCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxPayloadBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "./common.schema.json#/$defs/jsonObject"
        }
      }
    }
  }
}
