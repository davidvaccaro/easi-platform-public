{
  "kind": "EASI.CapabilityStatement",
  "version": "1.0.0",
  "implementation": {
    "name": "easi-js",
    "version": "1.0.0",
    "runtime": "node",
    "languages": [
      "javascript"
    ]
  },
  "features": {
    "process": true,
    "start": true,
    "routing": true,
    "dicom": true,
    "dicomweb": true,
    "dimse": true,
    "codegen": true,
    "testgen": true
  },
  "supportedSources": [
    {
      "operation": "fromFileStream",
      "stability": "stable"
    },
    {
      "operation": "fromHttpStream",
      "stability": "stable"
    }
  ]
}
