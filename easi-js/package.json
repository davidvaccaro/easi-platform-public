{
    "name": "dicom-js",
    "version": "1.0.0",
    "type": "module",
    "description": "A Modern Pure-Javascript DICOM implementation.",
    "engines": {
        "node": "18.x || 16.x"
    },
    "keywords": [
        "DICOM"
    ],
    "license": "Xinonix Interactive Development, Inc.",
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7.21.2",
        "jest": "^29.5.0"
    },
    "scripts": {
        "test": "jest",
        "bench:streaming": "RUN_STREAMING_BENCHMARKS=true jest test/benchmarks/StreamingPerformance.test.js --runInBand --coverage=false",
        "bench:bulk-policy": "node --expose-gc test/benchmarks/runDicomBulkPolicyProbe.js",
        "bench:compare": "node test/benchmarks/compareStreamingBenchmarks.js",
        "kitchen-sink": "node samples/kitchen-sink/server.js",
        "harness:test-library": "node tools/harness/runTestLibraryHarness.js",
        "harness:monitor": "node tools/harness/monitorHarnessRun.js",
        "harness:orchestrate": "node tools/harness/orchestrateHarnessRuns.js",
        "harness:merge": "node tools/harness/mergeHarnessRuns.js",
        "docs:api-contract": "node tools/contracts/generateApiContract.js",
        "docs:api-contract:check": "node tools/contracts/generateApiContract.js --check",
        "docs:api-reference": "node ../easi-spec/site/scripts/generate-api-reference.js",
        "docs:api-reference:all": "npm run docs:api-contract && npm run docs:api-reference",
        "test:dimse-sockets": "RUN_DIMSE_SOCKET_TESTS=true jest --runInBand test/transports/dimse/NodeDimseCStoreScuTransport.test.js test/transports/dimse/NodeDimseCStoreScpSourceTransport.test.js test/transports/dimse/NodeDimseQueryRetrieveSourceTransport.test.js test/integration/KitchenSinkDimseRelayApi.test.js",
        "test:orthanc-dimse": "RUN_ORTHANC_DIMSE=true jest test/integration/OrthancDimseInterop.test.js --runInBand",
        "test:orthanc-dimse-move": "RUN_ORTHANC_DIMSE_MOVE=true jest test/integration/OrthancDimseInterop.test.js --runInBand",
        "test:orthanc-dimse-all": "RUN_ORTHANC_DIMSE=true RUN_ORTHANC_DIMSE_MOVE=true jest test/integration/OrthancDimseInterop.test.js --runInBand",
        "bench:peers": "node tools/benchmarks/peer/runPeerBenchmarks.js",
        "bench:peers:bootstrap": "bash tools/benchmarks/peer/bootstrapPeerToolkits.sh"
    },
    "jest": {
        "collectCoverage": true,
        "testMatch": [
            "<rootDir>/test/**/*.test.js"
        ],
        "collectCoverageFrom": [
            "src/**/*.js"
        ]
    },
    "dependencies": {
        "@voxelmed/openjpegjs": "^0.0.2",
        "node-fetch": "^3.3.1"
    }
}
