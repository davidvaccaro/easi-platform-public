{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easi.dev/schemas/easi-api.contract.schema.json",
  "title": "EASI API Contract Schema",
  "description": "Schema for the generated master contract of the EASI JavaScript public API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "generator",
    "package",
    "source",
    "metrics",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string" },
        "mode": { "type": "string", "enum": ["write", "check"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "moduleCount"],
      "properties": {
        "root": { "type": "string" },
        "moduleCount": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportCount",
        "classCount",
        "methodCount",
        "functionCount",
        "constantCount"
      ],
      "properties": {
        "exportCount": { "type": "integer", "minimum": 0 },
        "classCount": { "type": "integer", "minimum": 0 },
        "methodCount": { "type": "integer", "minimum": 0 },
        "functionCount": { "type": "integer", "minimum": 0 },
        "constantCount": { "type": "integer", "minimum": 0 }
      }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "pluginContracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/pluginContract" }
    }
  },
  "$defs": {
    "jsonLikeObject": {
      "type": "object"
    },
    "pluginContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "name",
        "summary"
      ],
      "properties": {
        "id": { "type": "string" },
        "family": {
          "type": "string",
          "enum": [
            "codec"
          ]
        },
        "name": { "type": "string" },
        "summary": { "type": ["string", "null"] },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/pluginInterface" }
        },
        "registrationForms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "constructor",
              "instance",
              "provider",
              "factory"
            ]
          }
        },
        "languageProfiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/pluginLanguageProfile" }
        },
        "conformance": { "$ref": "#/$defs/pluginConformance" },
        "extensions": { "$ref": "#/$defs/jsonLikeObject" }
      }
    },
    "pluginInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requiredMethods"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "decoder",
            "image-decoder",
            "encoder"
          ]
        },
        "description": { "type": ["string", "null"] },
        "requiredMethods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contextSummary": { "type": ["string", "null"] },
        "outputSummary": { "type": ["string", "null"] }
      }
    },
    "pluginLanguageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "status"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "javascript",
            "csharp",
            "java",
            "python"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "official",
            "draft",
            "planned",
            "experimental"
          ]
        },
        "signature": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "pluginConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providersMustBeSynchronous",
        "promiseProvidersRejected",
        "requiredMethodsValidated"
      ],
      "properties": {
        "providersMustBeSynchronous": { "type": "boolean" },
        "promiseProvidersRejected": { "type": "boolean" },
        "requiredMethodsValidated": { "type": "boolean" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "category",
        "summary",
        "exports",
        "classes",
        "functions",
        "constants",
        "diagnostics"
      ],
      "properties": {
        "path": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": ["string", "null"] },
        "exports": {
          "type": "array",
          "items": { "$ref": "#/$defs/export" }
        },
        "classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/class" }
        },
        "functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/function" }
        },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/constant" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exportName", "symbolKind", "symbolName", "default"],
      "properties": {
        "exportName": { "type": "string" },
        "symbolKind": { "type": "string", "enum": ["class", "function", "constant"] },
        "symbolName": { "type": "string" },
        "default": { "type": "boolean" }
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "line",
        "exported",
        "defaultExport",
        "extends",
        "description",
        "deprecated",
        "examples",
        "properties",
        "members",
        "constants"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "exported": { "type": "boolean" },
        "defaultExport": { "type": "boolean" },
        "extends": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "deprecated": { "type": ["string", "null"] },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/member" }
        },
        "constants": {
          "type": "array",
          "items": { "$ref": "#/$defs/classConstant" }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "line",
        "exported",
        "defaultExport",
        "async",
        "description",
        "deprecated",
        "examples",
        "parameters",
        "returns"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "exported": { "type": "boolean" },
        "defaultExport": { "type": "boolean" },
        "async": { "type": "boolean" },
        "description": { "type": ["string", "null"] },
        "deprecated": { "type": ["string", "null"] },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returns": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/returns" }
          ]
        }
      }
    },
    "constant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "line",
        "declarationKind",
        "exported",
        "description",
        "deprecated",
        "examples",
        "initializerKind",
        "initializerSummary"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "declarationKind": { "type": "string", "enum": ["const", "let", "var"] },
        "exported": { "type": "boolean" },
        "description": { "type": ["string", "null"] },
        "deprecated": { "type": ["string", "null"] },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "initializerKind": {
          "type": "string",
          "enum": [
            "object",
            "array",
            "map",
            "set",
            "string",
            "boolean",
            "null",
            "undefined",
            "number",
            "expression",
            "unknown"
          ]
        },
        "initializerSummary": {
          "type": ["object", "null"]
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "optional", "type", "description"],
      "properties": {
        "name": { "type": "string" },
        "optional": { "type": "boolean" },
        "type": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "classConstant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fromMemberKind", "line", "description", "returnType"],
      "properties": {
        "name": { "type": "string" },
        "fromMemberKind": { "type": "string", "enum": ["getter", "method"] },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": ["string", "null"] },
        "returnType": { "type": ["string", "null"] }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "static",
        "async",
        "accessor",
        "line",
        "description",
        "deprecated",
        "parameters",
        "returns",
        "examples"
      ],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["constructor", "method", "getter", "setter"] },
        "static": { "type": "boolean" },
        "async": { "type": "boolean" },
        "accessor": { "type": ["string", "null"], "enum": ["get", "set", null] },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": ["string", "null"] },
        "deprecated": { "type": ["string", "null"] },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returns": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/returns" }
          ]
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "raw",
        "signature",
        "defaultValue",
        "optional",
        "rest",
        "destructured",
        "type",
        "description"
      ],
      "properties": {
        "name": { "type": "string" },
        "raw": { "type": "string" },
        "signature": { "type": "string" },
        "defaultValue": { "type": ["string", "null"] },
        "optional": { "type": "boolean" },
        "rest": { "type": "boolean" },
        "destructured": { "type": "boolean" },
        "type": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "documentedOnly": { "type": "boolean" }
      }
    },
    "returns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["warning", "error"] },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
